# JIRA settings
#
# JIRA_FLAVOR selects auth + REST API version:
#   cloud  → Basic auth (email + Atlassian API token), REST v3, ADF descriptions.
#            Base URL must be https://<tenant>.atlassian.net.
#            Get an API token: https://id.atlassian.com/manage-profile/security/api-tokens
#   server → Bearer auth (Personal Access Token), REST v2, plain-text descriptions.
#            Base URL is your self-hosted host (e.g. https://prod.jira.example.com).
#            Get a PAT: your JIRA profile → Personal Access Tokens → Create token.
#
# If JIRA_FLAVOR is omitted, watcher guesses `cloud` for *.atlassian.net URLs
# and `server` otherwise.
JIRA_FLAVOR=cloud
JIRA_BASE_URL=https://your-domain.atlassian.net

# Required for JIRA_FLAVOR=cloud; ignored for JIRA_FLAVOR=server.
JIRA_EMAIL=you@example.com

# Cloud: paste your Atlassian API token here.
# Server: paste your Personal Access Token (PAT) here.
JIRA_API_TOKEN=your_token_here

# Cloud-only: leave blank to auto-discover from <base>/_edge/tenant_info.
# Only set this if discovery is blocked (e.g. by a corporate proxy) or if you
# already know the cloudId. It's the UUID from https://<site>/_edge/tenant_info.
# JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000000

# Optional User-Agent override — some corporate WAFs block default clients.
# JIRA_USER_AGENT=Mozilla/5.0 (compatible; watcher/0.1)


# ---------------------------------------------------------------------------
# Integration connectivity (all optional — leave a section blank to skip it).
# Verify with:  watcher --check           (all configured)
#               watcher --check bitbucket (one)
# ---------------------------------------------------------------------------

# Bitbucket Cloud (Atlassian-hosted) or Data Center.
# For Cloud use an Atlassian API token (id.atlassian.com), NOT a Bitbucket
# app password. For Data Center set BITBUCKET_AUTH_MODE=bearer and paste a PAT.
# BITBUCKET_HOST=bitbucket.org
# BITBUCKET_WORKSPACE=your-workspace
# BITBUCKET_EMAIL=you@example.com
# BITBUCKET_API_TOKEN=
# BITBUCKET_AUTH_MODE=basic
# BITBUCKET_API_BASE=

# Jenkins. Create an API token from your Jenkins user profile → API Token.
# JENKINS_BASE_URL=https://jenkins.example.com
# JENKINS_USERNAME=your-jenkins-username
# JENKINS_API_TOKEN=

# GitHub. Either paste a Personal Access Token (repo scope) OR install and
# authenticate `gh` (https://cli.github.com); watcher prefers the CLI when
# both are available and GITHUB_USE_GH=1.
# GITHUB_TOKEN=
# GITHUB_USE_GH=

# EKS cluster (via aws + kubectl). Requires the AWS CLI v2 and kubectl on
# PATH, and valid AWS creds (usually `aws sso login` for SSO orgs).
# When configured, `watcher --resolve` uses `kubectl` to probe deployments
# whose names match a ticket's JIRA Components / Labels — the results are
# fed to the LLM as live evidence for the Verdict.
# EKS_CLUSTER_NAME=your-cluster-name
# EKS_REGION=us-east-1
# EKS_NAMESPACE=default
# AWS_PROFILE=
# Optional: pin the kubectl context used for read-only probes. If unset,
# watcher lists your available contexts and asks which to use.
# KUBE_CONTEXT=arn:aws:eks:us-east-1:123456789012:cluster/prod

# Optional: override the JQL used to fetch tickets
# Default: assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC
# JIRA_JQL=assignee = currentUser() AND resolution = Unresolved ORDER BY updated DESC

# LLM provider — one of: claude, codex, cursor
# The chosen provider must be installed locally as a CLI on your PATH.
#   claude  → Claude Code (`claude`)
#   codex   → OpenAI Codex CLI (`codex`)
#   cursor  → Cursor Agent CLI (`cursor-agent`)
LLM_PROVIDER=claude

# Optional: override the binary path for the selected provider
# LLM_CLI_PATH=/opt/homebrew/bin/claude

# Watch mode default interval, in seconds
WATCHER_INTERVAL=300

# Where to persist ticket→category memory. Default resolution:
#   1. If watcher is installed from source (pyproject.toml alongside the
#      package), it writes to <project-root>/memory/memory.json so the file
#      lives next to the install and is easy to inspect / gitignore.
#   2. Otherwise (pip install jira-watcher-agent from PyPI), it falls back
#      to ~/.watcher/memory.json.
# Set an absolute path here to override both.
# WATCHER_MEMORY_PATH=/absolute/path/to/memory.json
